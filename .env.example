# Set any ONE provider key if you use Tier 2 (Tier 1 label matching needs no API key).
# Provider is auto-detected from --provider / DECISION_PROVIDER / model ID / set key.

# OpenRouter Decisions API (/api/alpha/decisions — 40+ decision models via one key, default: liquid/d1.2)
# OPENROUTER_API_KEY=

# OpenAI Decisions API (/v1/decisions, default model: gpt-6-luna)
OPENAI_API_KEY=

# Google Gemini Decisions API (/v1beta/decisions, default model: gemini-decision-1)
# GEMINI_API_KEY=

# TypeSafe AI System One API (/v1/systemone, default model: jev-latest)
# TYPESAFE_API_KEY=

# Liquid AI System One API (/decisions/v1/systemone, default model: d1.2)
# LIQUID_API_KEY=

# Optional overrides
# DECISION_PROVIDER=openrouter
# DECISION_MODEL=google/gemini-decision-1
# DECISION_BASE_URL=
